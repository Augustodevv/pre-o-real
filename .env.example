# Histórico compartilhado (Fase 2, opcional). Sem estas variáveis, a extensão funciona
# normalmente e a opção "Participar do histórico compartilhado" fica indisponível.
# A chave é a "publishable key" (pública por natureza); o banco só expõe duas funções.
WXT_SUPABASE_URL=https://SEU-PROJETO.supabase.co
WXT_SUPABASE_KEY=sb_publishable_...
